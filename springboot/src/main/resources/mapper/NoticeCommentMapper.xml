<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.springboot.mapper.NoticeCommentMapper">
    <resultMap id="NoticeCommentResultMap" type="com.example.springboot.entity.NoticeComment">
        <id property="id" column="id"/>
        <result property="noticeId" column="notice_id"/>
        <result property="userId" column="user_id"/>
        <result property="userName" column="user_name"/>
        <result property="userAvatar" column="user_avatar"/>
        <result property="content" column="content"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectByNoticeId" resultMap="NoticeCommentResultMap">
        SELECT
            c.id,
            c.notice_id,
            c.user_id,
            COALESCE(NULLIF(c.user_name, ''), u.name, u.username, '匿名ユーザー') AS user_name,
            COALESCE(NULLIF(u.avatar, ''), c.user_avatar, '') AS user_avatar,
            c.content,
            c.create_time
        FROM notice_comment c
        LEFT JOIN user u ON u.id = c.user_id
        WHERE c.notice_id = #{noticeId}
        ORDER BY c.id DESC
    </select>
</mapper>
